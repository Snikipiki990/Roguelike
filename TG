def handle_text_conversion(chat_id: int, text: str):
    if text.lower() == '/cancel':
        if chat_id in user_data:
            user_data[chat_id] = {}
        send_message(chat_id, "✅ Действие отменено. Используйте /start для главного меню.", get_main_keyboard())
        return
    
    if '+' in text or ' плюс ' in text or ' и ' in text:
        handle_sum(chat_id, text)
        return
    
    if user_data.get(chat_id, {}).get('awaiting_amount'):
        try:
            amount = float(text.replace(',', '.'))
            from_curr = user_data[chat_id]['from_currency']
            to_curr = user_data[chat_id]['to_currency']
            
            if amount <= 0:
                send_message(chat_id, "❌ Пожалуйста, введите положительное число.")
                return
            
            send_message(chat_id, "🔄 Получаю актуальный курс...")
            rates = get_unified_rates()
            
            if rates:
                result = convert(amount, from_curr, to_curr, rates)
                
                if result is not None:
                    from_name = CURRENCIES[from_curr][0]
                    from_emoji = CURRENCIES[from_curr][1]
                    to_name = CURRENCIES[to_curr][0]
                    to_emoji = CURRENCIES[to_curr][1]
                    
                    result_text = (
                        f"✅ *Результат конвертации:*\n\n"
                        f"{from_emoji} {format_number(amount)} {from_curr} ({from_name})\n"
                        f"➡️\n"
                        f"{to_emoji} {format_number(result)} {to_curr} ({to_name})\n\n"
                        f"📊 *Курс:* 1 {from_curr} = {(result / amount):.4f} {to_curr}"
                    )
                    
                    send_message(chat_id, result_text, get_result_keyboard())
                else:
                    send_message(chat_id, "❌ Ошибка при конвертации. Проверьте правильность валют.")
            else:
                send_message(chat_id, "❌ Не удалось получить курсы валют. Попробуйте позже.")
            
            user_data[chat_id] = {}
            
        except ValueError:
            send_message(chat_id, "❌ Пожалуйста, введите корректное число (например: 100 или 50.5)")
        return
    
    amount, from_curr, to_curr = parse_user_input(text)
    
    if amount is None or from_curr is None or to_curr is None:
        send_message(chat_id,
                     "❌ Не удалось распознать запрос.\n\n"
                     "📝 *Правильные форматы:*\n"
                     "• Конвертация: `100 usd rub` или `100 долларов в евро`\n"
                     "• Сложение: `100 usd + 50 eur` или `100 долларов и 50 евро`\n\n"
                     "💡 Напишите /help для подробной инструкции.")
        return
    
    send_message(chat_id, "🔄 Получаю актуальный курс...")
    rates = get_unified_rates()
    
    if rates:
        result = convert(amount, from_curr, to_curr, rates)
        
        if result is not None:
            from_name = CURRENCIES.get(from_curr, (from_curr, '💱'))[0]
            from_emoji = CURRENCIES.get(from_curr, (from_curr, '💱'))[1]
            to_name = CURRENCIES.get(to_curr, (to_curr, '💱'))[0]
            to_emoji = CURRENCIES.get(to_curr, (to_curr, '💱'))[1]
            
            result_text = (
                f"✅ *Результат:*\n\n"
                f"{from_emoji} {format_number(amount)} {from_curr}\n"
                f"➡️\n"
                f"{to_emoji} {format_number(result)} {to_curr}\n\n"
                f"📊 Курс: 1 {from_curr} = {(result / amount):.4f} {to_curr}"
            )
            
            send_message(chat_id, result_text, get_result_keyboard())
        else:
            send_message(chat_id, "❌ Ошибка при конвертации.")
    else:
        send_message(chat_id, "❌ Не удалось получить курсы валют.")

def handle_sum(chat_id: int, text: str):
    send_message(chat_id, "🔄 Получаю актуальные курсы...")
    
    rates = get_unified_rates()
    
    if not rates:
        send_message(chat_id, "❌ Не удалось получить курсы валют. Попробуйте позже.")
        return
    
    total_rub, calculation = parse_sum_input(text, rates)
    
    if total_rub is None:
        send_message(chat_id,
                     "❌ Не удалось распознать запрос.\n\n"
                     "📝 *Правильные форматы:*\n"
                     "• `100 usd + 50 eur`\n"
                     "• `100 долларов и 50 евро`\n\n"
                     "💡 Используйте /sum для помощи")
        return
    
    result_text = (
        f"➕ *Результат сложения:*\n\n"
        f"{calculation}\n\n"
        f"💰 *Общая сумма:* {format_number(total_rub)} ₽\n"
        f"📊 Курсы обновлены: {datetime.now().strftime('%H:%M:%S')}"
    )
    
    send_message(chat_id, result_text, get_sum_result_keyboard())
    
    if chat_id in user_data:
        user_data[chat_id].pop('awaiting_sum', None)


def main():
    print("Бот запущен")    
    last_update_id = 0
    
    while True:
        try:
            updates = get_updates(last_update_id + 1 if last_update_id else None)
            
            for update in updates:
                last_update_id = update['update_id']
                
                if 'callback_query' in update:
                    callback = update['callback_query']
                    chat_id = callback['message']['chat']['id']
                    message_id = callback['message']['message_id']
                    callback_data = callback['data']
                    callback_id = callback['id']
                    
                    answer_callback_query(callback_id)
                    
                    if callback_data == 'back_to_menu':
                        handle_start(chat_id)
                    elif callback_data == 'help':
                        handle_help(chat_id, message_id)
                    elif callback_data == 'show_rates':
                        handle_rates(chat_id, message_id)
                    elif callback_data == 'show_list':
                        handle_list(chat_id, message_id)
                    elif callback_data == 'convert_menu':
                        handle_convert_menu(chat_id, message_id)
                    elif callback_data == 'sum_menu':
                        handle_sum_menu(chat_id, message_id)
                    elif callback_data.startswith('select_from_'):
                        currency = callback_data.replace('select_from_', '')
                        handle_select_from(chat_id, message_id, currency)
                    elif callback_data.startswith('select_to_'):
                        currency = callback_data.replace('select_to_', '')
                        handle_select_to(chat_id, message_id, currency)
                
                elif 'message' in update:
                    message = update['message']
                    chat_id = message['chat']['id']
                    text = message.get('text', '')
                    
                    if text.startswith('/start'):
                        handle_start(chat_id)
                    elif text.startswith('/help'):
                        handle_help(chat_id)
                    elif text.startswith('/rates'):
                        handle_rates(chat_id)
                    elif text.startswith('/list'):
                        handle_list(chat_id)
                    elif text.startswith('/'):
                        send_message(chat_id, "❌ Неизвестная команда. Используйте /help", get_main_keyboard())
                    else:
                        handle_text_conversion(chat_id, text)
            
            time.sleep(0.5)
            
        except Exception as e:
            print(f"Ошибка в главном цикле: {e}")
            time.sleep(3)

if __name__ == '__main__':
    main()
