def get_free_rates(base_currency: str = 'USD') -> Optional[Dict]:
    try:
        response = requests.get(f'https://api.exchangerate-api.com/v4/latest/{base_currency}', timeout=15)
        if response.status_code == 200:
            data = response.json()
            print(f"✅ API: получено {len(data['rates'])} курсов")
            return data['rates']
        else:
            print(f"❌ API вернул статус: {response.status_code}")
            return None
    except requests.Timeout:
        print("❌ Таймаут при запросе к API")
        return None
    except Exception as e:
        print(f"❌ Ошибка API: {e}")
        return None

def get_unified_rates() -> Optional[Dict[str, float]]:
    global rates_cache

    if rates_cache['timestamp'] and datetime.now() - rates_cache['timestamp'] < timedelta(minutes=CACHE_MINUTES):
        print("📦 Использую кэшированные курсы")
        return rates_cache['rates']

    print("🔄 Обновляю курсы валют...")

    free_rates = get_free_rates('USD')

    if not free_rates:
        print("❌ Не удалось получить курсы")
        return None

    unified_rates = {}

    if 'RUB' in free_rates:
        usd_to_rub = free_rates['RUB']

        for code in CURRENCIES.keys():
            if code == 'RUB':
                unified_rates[code] = 1.0
            elif code == 'USD':
                unified_rates[code] = usd_to_rub
            elif code in free_rates:
                unified_rates[code] = usd_to_rub / free_rates[code]

        print(f"✅ Курсы обновлены: USD = {unified_rates.get('USD', 0):.2f} RUB")
        rates_cache['rates'] = unified_rates
        rates_cache['timestamp'] = datetime.now()
        return unified_rates
    else:
        print("❌ В API нет курса RUB")
        return None

def convert(amount: float, from_currency: str, to_currency: str, rates: Dict[str, float]) -> Optional[float]:
    from_rate = rates.get(from_currency.upper())
    to_rate = rates.get(to_currency.upper())

    if not from_rate or not to_rate:
        return None

    amount_in_rub = amount * from_rate
    result = amount_in_rub / to_rate
    return result

def parse_sum_input(text: str, rates: Dict[str, float]) -> Tuple[Optional[float], Optional[str]]:
    text = text.lower().strip()
    text = text.replace('+', ' + ')
    text = text.replace('и', '+')
    text = text.replace('плюс', '+')

    pattern = r'(\d+(?:[.,]\d+)?)\s*([a-zа-яё$€£₽]+)'
    matches = re.findall(pattern, text)

    if len(matches) < 2:
        return None, None

    total_rub = 0.0
    calculation_parts = []

    for amount_str, currency_text in matches:
        try:
            amount = float(amount_str.replace(',', '.'))
            currency_code = None

            if currency_text.upper() in CURRENCIES:
                currency_code = currency_text.upper()
            elif currency_text in RUSSIAN_NAMES:
                currency_code = RUSSIAN_NAMES[currency_text]

            if currency_code and currency_code in rates:
                rub_amount = amount * rates[currency_code]
                total_rub += rub_amount

                emoji = CURRENCIES.get(currency_code, (currency_code, '💱'))[1]
                calculation_parts.append(f"{emoji} {amount} {currency_code}")
            else:
                return None, None
        except ValueError:
            return None, None

    if len(calculation_parts) >= 2:
        result_text = " + ".join(calculation_parts)
        return total_rub, result_text

    return None, None

def parse_user_input(text: str) -> Tuple[Optional[float], Optional[str], Optional[str]]:
    text = text.lower().strip()
    text = text.replace(',', '.')

    if '+' in text or ' плюс ' in text or ' и ' in text:
        return 'sum', None, None

    words_to_remove = ['переведи', 'конвертируй', 'сколько', 'будет', 'в', 'из', 'по', 'помоги']
    for word in words_to_remove:
        text = text.replace(word, '')

    parts = text.split()

    amount = None
    from_curr = None
    to_curr = None

    valid_codes = set(CURRENCIES.keys())

    if '→' in text or '->' in text or ' в ' in text:
        arrow_pos = -1
        for i, part in enumerate(parts):
            if part in ['→', '->', 'в']:
                arrow_pos = i
                break

        if arrow_pos > 0:
            left_parts = parts[:arrow_pos]
            right_parts = parts[arrow_pos+1:]

            for part in left_parts:
                try:
                    amount = float(part)
                except ValueError:
                    part_upper = part.upper()
                    if part_upper in valid_codes:
                        from_curr = part_upper
                    elif part in RUSSIAN_NAMES:
                        from_curr = RUSSIAN_NAMES[part]

            for part in right_parts:
                part_upper = part.upper()
                if part_upper in valid_codes:
                    to_curr = part_upper
                elif part in RUSSIAN_NAMES:
                    to_curr = RUSSIAN_NAMES[part]

    if amount is None or from_curr is None or to_curr is None:
        for part in parts:
            try:
                if amount is None:
                    amount = float(part)
                continue
            except ValueError:
                pass

            part_upper = part.upper()
            if part_upper in valid_codes:
                if from_curr is None:
                    from_curr = part_upper
                else:
                    to_curr = part_upper
            elif part in RUSSIAN_NAMES:
                if from_curr is None:
                    from_curr = RUSSIAN_NAMES[part]
                else:
                    to_curr = RUSSIAN_NAMES[part]

    return amount, from_curr, to_curr

def format_number(num: float) -> str:
    if num >= 1:
        return f"{num:,.2f}".replace(",", " ")
    else:
        return f"{num:.4f}"


